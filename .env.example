# Supabase — set these in Netlify dashboard under Site → Environment variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram bot — get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Kiev local hour (0-23) at which to send daily notifications
NOTIFICATION_HOUR=9
