# Supabase — set these in Netlify dashboard under Site → Environment variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram bot — get token from @BotFather, chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=123456789:ABCDEFxxxxxxxxxxxxxxxx
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# Secret token for verifying Telegram webhook requests (any random string you choose)
# Register it with: POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   {"url": "https://your-site.netlify.app/webhook", "secret_token": "<this value>"}
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Kiev local hour (0-23) for each daily notification
NOTIFICATION_HOUR_MORNING=6
NOTIFICATION_HOUR_EVENING=21
