# Supabase — set these in Netlify dashboard under Site → Environment variables
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Telegram — bot token and chat ID are now stored per-coliving in the colivings table.
# Configure them via the Settings modal (gear icon) in the app.

# Shared secret for verifying Telegram webhook calls (register per bot with setWebhook)
# POST https://api.telegram.org/bot<TOKEN>/setWebhook
#   {"url": "https://your-site.netlify.app/webhook", "secret_token": "<this value>"}
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here

# Kiev local hour (0-23) for each daily notification
NOTIFICATION_HOUR_MORNING=6
NOTIFICATION_HOUR_EVENING=21
